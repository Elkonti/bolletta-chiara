# Serves the static site. Without a domain it answers on plain HTTP by IP;
# with one, replace ":80" by the domain and Caddy gets an HTTPS certificate itself.
:80 {
	root * /var/www/bolletta
	encode gzip zstd
	file_server
	header {
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	@data path /data/*
	header @data Cache-Control "public, max-age=3600"
	# Pages, scripts and styles: browsers check for a new version every time
	# (a cheap 304 when unchanged), so a deploy is seen at once.
	@code path / *.html *.js *.css *.webmanifest
	header @code Cache-Control "no-cache"
	log {
		# Errors only: no access log, so no visitor IPs are stored.
		output discard
	}
}
